plugins {
    id 'nf-amazon'
}
manifest {
    name            = 'AMR-Flow-Fargate-Wave'
    author          = 'Naouel'
    description     = 'AMR Detection Pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

// --- 1. GLOBAL PARAMETERS ---
params {
    input    = "sample.tsv"
    outdir   = "s3://${System.getenv('AMR_COMPUTE_BUCKET') ?: 'mock-compute-bucket'}/results"

    // Database Paths
    
    bakta_db = "s3://${System.getenv('AMR_STATIC_BUCKET') ?: 'mock-static-bucket'}/databases/bakta_db"
    amr_db   = "s3://${System.getenv('AMR_STATIC_BUCKET') ?: 'mock-static-bucket'}/databases/amr_db/2026-01-21.1"

    fastp_args = '--cut_front --cut_tail --trim_poly_g'
  
}

// --- 2. EXECUTION PROFILES ---
profiles {
    test {
        docker.enabled    = true
        process.executor  = 'local'
        
        params.input_dir  = "${projectDir}/../tests/data" 
        params.outdir     = "${projectDir}/../tests/results"
        
        // Pointing to the small test files
        params.input      = "${params.input_dir}/manifest.tsv" 
        params.reads      = "${params.input_dir}/test_R{1,2}.fastq.gz"
        params.long_reads = "${params.input_dir}/test_long.fastq.gz"

        // IMPORTANT: Skip heavy database steps for the test
        params.skip_bakta = true
        params.skip_amr   = true

        process {
            cpus   = 2
            memory = '6 GB'
            // Ensure test results are saved locally
            publishDir = [
                path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
                mode: 'copy'
            ]
      
        // --- ADDED CONTAINERS HERE SO THE TEST PROFILE CAN SEE THEM ---
            withName: '.*FASTP.*'     { container = 'staphb/fastp:0.23.4'}
            withName: 'UNICYCLER_.*'  { container = 'staphb/unicycler:0.5.0' }
            withName: 'FLYE.*'        { container = 'staphb/flye:2.9.3' }
            withName: 'BAKTA'         { container = 'staphb/bakta:1.9.4' }
            withName: 'AMRFINDERPLUS' { container = 'staphb/ncbi-amrfinderplus:latest' }
            withName: 'DNAAPLER.*'    { container = 'staphb/dnaapler:0.7.0' }
            withName: 'FILTLONG.*'    { container = 'staphb/filtlong:0.2.1' }
            withName: 'PYPOLCA.*'     { container = 'staphb/pypolca:0.3.1' }
            withName: 'BWA_MEM'       { container = 'staphb/bwa:0.7.17' }
            withName: 'POLYPOLISH'    { container = 'staphb/polypolish:0.6.0' }
            withName: 'MEDAKA.*'      { container = 'ontresearch/medaka:latest' }
        }
    
    }
    docker {
        docker.enabled    = true
        process.executor  = 'local'
    }
    aws {
        wave.enabled          = true
        fusion.enabled        = true
        wave.strategy         = ['container', 'dockerfile']


    client {
        // Force modern S3 API behavior. No ACLs, no complex headers.
        storageEncryption = 'AES256'
        uploadStorageClass = 'STANDARD'
        s3PathStyleAccess = true 
    }
    
  
        aws.region            = 'us-east-1'
        aws.batch.platformType  = 'ec2'
  
        aws.batch.jobRole       = System.getenv('AMR_JOB_ROLE_ARN')
        aws.batch.executionRole = System.getenv('AMR_JOB_ROLE_ARN')     
        aws.batch.subnets       = System.getenv('AMR_SUBNETS')?.split(',')
        aws.batch.securityGroups= System.getenv('AMR_SECURITY_GROUPS')?.split(',')
        workDir = "s3://${System.getenv('AMR_COMPUTE_BUCKET') ?: 'mock-compute-bucket'}/work"
        cleanup = true
        
        process {
            executor = 'awsbatch'
            queue  = System.getenv('AMR_EC2_QUEUE')
         
           
            errorStrategy = { task.exitStatus in [130, 137, 139, 140, 143, -1] ? 'retry' : 'finish' }
            maxRetries    = 3
           
     
            cpus                   = 2
            memory                 = '4 GB'
          
            // Standardize S3 publishing
            publishDir = [
                path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
                mode: 'copy'
            ]
            withName: 'BAKTA' {
                cpus   = 8
                memory = '32 GB'
               
            }

            withName: 'FASTP|AMRFINDERPLUS|DNAAPLER' {
                cpus = 4
                memory = '8 GB'
            }
            withName: 'UNICYCLER_.*|FLYE.*|MEDAKA_.*|PYPOLCA|BWA_MEM|POLYPOLISH' {
                cpus = 8
                memory = '64 GB'
              
            }
          
            withName: '.*FASTP.*'     { container = 'staphb/fastp:0.23.4'}
            withName: 'UNICYCLER_.*'  { container = 'staphb/unicycler:0.5.0' }
            withName: 'FLYE.*'        { container = 'staphb/flye:2.9.3' }
            withName: 'BAKTA'         { container = 'staphb/bakta:1.9.4' }
            withName: 'AMRFINDERPLUS' { container = 'staphb/ncbi-amrfinderplus:latest' }
            withName: 'DNAAPLER.*'    { container = 'staphb/dnaapler:0.7.0' }
            withName: 'FILTLONG.*'    { container = 'staphb/filtlong:0.2.1' }
            withName: 'PYPOLCA.*'     { container = 'staphb/pypolca:0.3.1' }
            withName: 'BWA_MEM'       { container = 'staphb/bwa:0.7.17' }
            withName: 'POLYPOLISH'    { container = 'staphb/polypolish:0.6.0' }
            withName: 'MEDAKA.*'      { container = 'ontresearch/medaka:latest' }
        }
        aws.batch.maxParallelTransfers = 2
        aws.batch.delayBetweenAttempts = '5 sec'
        cleanup = true
    }
}

// --- 3. REPORTING ---
// Standardized reporting block
timeline.enabled = true
timeline.file    = "pipeline_info/execution_timeline.html"
report.enabled   = true
report.file      = "pipeline_info/execution_report.html"

report.overwrite   = true
timeline.overwrite = true